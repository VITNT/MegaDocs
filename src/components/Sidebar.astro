---
import { grades, terms } from '../data/archive';

---

<aside class="sidebar" id="sidebar">
  <div class="side-scroll">
    <a class="side-title" href="/archive">Exam archive</a>

    <nav aria-label="Grade navigation">
      {
        grades.map((grade) => {
          return (
            <section class="grade-group">
              <button
                class="grade-button"
                data-grade={grade}
                aria-expanded="false"
              >
                <span>{grade}</span>
                <svg viewBox="0 0 20 20" aria-hidden="true">
                  <path d="m5 7 5 5 5-5"></path>
                </svg>
              </button>

              <div class="term-list">
                {terms.map((term) => (
                  <button
                    class="term-button"
                    data-grade={grade}
                    data-term={term}
                  >
                    {term}
                  </button>
                ))}
              </div>
            </section>
          );
        })
      }
    </nav>
  </div>
</aside>
