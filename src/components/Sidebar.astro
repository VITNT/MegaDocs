---
import { grades as archiveGrades, terms as archiveTerms } from '../data/archive';

interface Props {
  grades?: readonly string[];
  library?: 'archive' | 'jomlery';
  counts?: Record<string, number>;
}

const { grades = archiveGrades, library = 'archive', counts = {} } = Astro.props;
const isJomlery = library === 'jomlery';
const terms = isJomlery ? [] : archiveTerms;

---

<aside class="sidebar" id="sidebar">
  <div class="side-scroll">
    <a class="side-title" href={`/${library}`}>{isJomlery ? 'Khmer Answer library' : 'Your learning library'} <span aria-hidden="true">↗</span></a>

    <nav aria-label="Grade navigation">
      {
        grades.map((grade) => {
          return (
            <section class="grade-group">
              <button
                class="grade-button"
                id={`grade-${grade.replace('Grade ', '')}`}
                data-grade={grade}
                aria-expanded={isJomlery ? undefined : 'false'}
                aria-pressed={isJomlery ? 'false' : undefined}
                aria-controls={isJomlery ? undefined : `terms-${grade.replace('Grade ', '')}`}
              >
                <span class="grade-button-label"><span class="grade-number" aria-hidden="true">{grade.replace('Grade ', '')}</span>{grade}</span>
                {isJomlery ? <span class="grade-document-count">{counts[grade] || 'Soon'}</span> : <svg viewBox="0 0 20 20" aria-hidden="true">
                  <path d="m5 7 5 5 5-5"></path>
                </svg>}
              </button>

              {!isJomlery && <div class="term-list" id={`terms-${grade.replace('Grade ', '')}`} inert>
                <div class="term-list-inner">
                {terms.map((term, index) => (
                  <button
                    class="term-button"
                    data-grade={grade}
                    data-term={term}
                    style={`--term-order: ${index}`}
                  >
                    {term}
                  </button>
                ))}
                </div>
              </div>}
            </section>
          );
        })
      }
    </nav>
    <div class="sidebar-tip"><span aria-hidden="true">✦</span><strong>A little every day.</strong><p>{isJomlery ? 'Pick a grade, find your subject, and open an answer key.' : 'Pick a term, find your notes, and take it one page at a time.'}</p></div>
  </div>
</aside>
