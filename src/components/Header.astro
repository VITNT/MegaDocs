<header class="topbar">
  <a class="brand" href="/">MegaDocs</a>

  <nav class="directory" aria-label="Current location">
    <button id="archiveCrumb" type="button">Archive</button>
    <svg class="grade-separator" viewBox="0 0 20 20" aria-hidden="true">
      <path d="m7 4 6 6-6 6"></path>
    </svg>

    <button id="gradeCrumb" type="button">Grade 11</button>
    <svg class="term-separator" viewBox="0 0 20 20" aria-hidden="true">
      <path d="m7 4 6 6-6 6"></path>
    </svg>

    <button class="current" id="termCrumb" type="button">Term 4</button>
  </nav>

  <div class="top-actions">
    <label class="search-field" aria-label="Search notes">
      <svg viewBox="0 0 24 24" aria-hidden="true">
        <path d="m21 21-4.3-4.3m2.3-5.2a7.5 7.5 0 1 1-15 0 7.5 7.5 0 0 1 15 0Z"></path>
      </svg>
      <input id="searchInput" type="search" placeholder="Search" autocomplete="off" />
      <kbd>⌘ K</kbd>
    </label>

    <button class="icon-button" id="themeButton" aria-label="Switch color theme">
      <svg viewBox="0 0 24 24" aria-hidden="true">
        <path d="M12 3a9 9 0 1 0 9 9 7 7 0 0 1-9-9Z"></path>
      </svg>
    </button>

    <button
      class="icon-button menu-button"
      id="menuButton"
      aria-label="Open navigation"
      aria-expanded="false"
    >
      <svg viewBox="0 0 24 24" aria-hidden="true">
        <path d="M4 7h16M4 12h16M4 17h16"></path>
      </svg>
    </button>
  </div>
</header>
