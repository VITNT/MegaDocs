---
import Brand from './Brand.astro';
import ThemeToggle from './ThemeToggle.astro';
---
<header class="topbar">
  <Brand />

  <nav class="directory" aria-label="Current location">
    <button id="archiveCrumb" type="button">Archive</button>
    <svg class="grade-separator" hidden viewBox="0 0 20 20" aria-hidden="true">
      <path d="m7 4 6 6-6 6"></path>
    </svg>

    <button id="gradeCrumb" type="button" hidden></button>
    <svg class="term-separator" hidden viewBox="0 0 20 20" aria-hidden="true">
      <path d="m7 4 6 6-6 6"></path>
    </svg>

    <button id="termCrumb" type="button" hidden></button>
  </nav>

  <div class="top-actions">
    <button class="search-field" id="searchButton" type="button" aria-label="Search documents" aria-haspopup="dialog" aria-controls="searchDialog">
      <svg viewBox="0 0 24 24" aria-hidden="true">
        <path d="m21 21-4.3-4.3m2.3-5.2a7.5 7.5 0 1 1-15 0 7.5 7.5 0 0 1 15 0Z"></path>
      </svg>
      <span>Search</span>
      <kbd>⌘ K</kbd>
    </button>

    <ThemeToggle />

    <button
      class="icon-button menu-button"
      id="menuButton"
      aria-label="Open navigation"
      aria-expanded="false"
    >
      <svg viewBox="0 0 24 24" aria-hidden="true">
        <path d="M4 7h16M4 12h16M4 17h16"></path>
      </svg>
    </button>
  </div>
</header>

<dialog class="search-dialog" id="searchDialog" aria-labelledby="searchTitle">
  <div class="search-dialog-heading">
    <h2 id="searchTitle">Search documents</h2>
    <button class="icon-button" id="closeSearch" type="button" aria-label="Close search">✕</button>
  </div>
  <input id="searchInput" class="modal-search-input" type="search" placeholder="Search by title, grade, term, or subject…" aria-label="Search all documents" autocomplete="off" autofocus />
  <p class="search-status" id="searchStatus" role="status">Search across all grades and terms.</p>
  <div class="search-results" id="searchResults"></div>
</dialog>
