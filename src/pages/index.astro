---
import Header from '../components/Header.astro';
import ResourceTable from '../components/ResourceTable.astro';
import Sidebar from '../components/Sidebar.astro';
import { resources } from '../data/archive';
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="MegaDocs"
  description="Past exam notes organized across four grades, four terms, and nine subjects."
>
  <Header />

  <div class="app-shell" id="top">
    <Sidebar />

    <main class="content">
      <article class="document">
        <section class="intro" aria-labelledby="pageTitle">
          <h1 id="pageTitle">Grade 11 — Term 4</h1>
          <p id="pageDescription">Revision notes for this exam term.</p>
        </section>

        <ResourceTable resources={resources} />
      </article>
    </main>

  </div>

  <div class="scrim" id="scrim" hidden></div>

  <script src="../scripts/archive.ts"></script>
</BaseLayout>
